{
  "name": "somiland-vtuber",
  "version": "0.1.0",
  "description": "Personal macOS VTuber app based on XR Animator/System Animator Online.",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "app": "electron .",
    "dev": "electron . --dev",
    "package:mac": "electron-builder --mac --dir",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {
    "@electron/remote": "^2.1.3"
  },
  "devDependencies": {
    "electron": "^37.3.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.somiland.vtuber",
    "productName": "Somiland VTuber",
    "asar": false,
    "files": [
      "**/*",
      "!dist{,/**}",
      "!_private{,/**}",
      "!TEMP/_config_local{,/**}",
      "!.git{,/**}"
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "category": "public.app-category.video",
      "icon": "icon_SA_512x512.png",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSCameraUsageDescription": "Somiland VTuber uses your camera for avatar motion tracking.",
        "NSMicrophoneUsageDescription": "Somiland VTuber may use your microphone for lip sync or audio-reactive avatar features."
      }
    }
  }
}
